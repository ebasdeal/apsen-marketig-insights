{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint -- --fix)",
      "Bash(npm test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npx vitest run:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx next typegen)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Bash(npm publish:*)"]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
